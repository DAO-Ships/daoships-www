# ── External app / docs hosts (deep-linked from CTAs) ──
NEXT_PUBLIC_APP_URL=https://app.daoships.org
NEXT_PUBLIC_TESTNET_APP_URL=https://testnet.daoships.org

# ── Live stats from the DAO Ships indexer (optional) ──
# When set, the landing page pulls real ds_daos / ds_members / ds_proposals counts
# via Supabase PostgREST. When unset, the stat strip falls back gracefully to "—".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_INDEXER_SCHEMA=mainnet
